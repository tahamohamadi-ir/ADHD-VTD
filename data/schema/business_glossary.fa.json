  "terms": {
    "افسردگی": {
      "canonical_term": "depression",
      "ambiguity_level": "high",
      "why_ambiguous_fa": "افسردگی در دیتاست‌های مختلف به صورت binary flag، score، diagnosis flag، disorder value یا prevalence percentage آمده است.",
      "domain_interpretations": [
        {
          "domain": "student_depression",
          "preferred_table": "student_depression",
          "preferred_columns": [
            "student_depression.depression_flag"
          ],
          "meaning_fa": "وجود/عدم وجود افسردگی در دیتاست اصلی دانشجویان",
          "default_filter": "student_depression.depression_flag = 1",
          "negative_filter": "student_depression.depression_flag = 0",
          "example_question_fa": "چند دانشجو افسردگی دارند؟"
        },
        {
          "domain": "general_mental_health",
          "preferred_table": "mental_health_general",
          "preferred_columns": [
            "mental_health_general.depression_score"
          ],
          "meaning_fa": "نمره افسردگی در دیتاست عمومی سلامت روان",
          "default_metric": "AVG(mental_health_general.depression_score)",
          "example_question_fa": "میانگین نمره افسردگی در دیتاست عمومی چقدر است؟"
        },
        {
          "domain": "university_student_survey",
          "preferred_table": "university_student_mental_health",
          "preferred_columns": [
            "university_student_mental_health.depression_diagnosis"

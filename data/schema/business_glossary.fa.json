          "meaning_fa": "تشخیص افسردگی در نظرسنجی کوچک دانشگاهی",
          "default_filter": "university_student_mental_health.depression_diagnosis = 'Yes'",
          "example_question_fa": "در نظرسنجی دانشگاهی چند نفر تشخیص افسردگی دارند؟"
        },
        {
          "domain": "global_prevalence_long",
          "preferred_table": "country_prevalence_long",

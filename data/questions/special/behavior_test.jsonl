{"id": "VTD-EVAL-080", "difficulty": "complex", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "cross-source mental helth رو یکی کن و بگو depression flag کجا بالاتره، با caveat.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql_with_caveat", "expected_clarification_fa": "", "expected_sql": "SELECT source_name,COUNT(*) AS n,ROUND(100.0*SUM(CASE WHEN depression_flag=1 THEN 1 ELSE 0 END)/COUNT(*),2) AS depression_flag_rate_pct FROM vw_unified_individual_mental_health WHERE depression_flag IS NOT NULL GROUP BY source_name ORDER BY depression_flag_rate_pct DESC;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "complex robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-029", "difficulty": "medium", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "اول نرخ افسردگی رو برای شهرها بده، بعد فقط شهرهای بالای ۱۰۰۰ نمونه رو نگه دار.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "SELECT city, COUNT(*) AS n, ROUND(100.0*SUM(depression_flag)/COUNT(*),2) AS depression_rate_pct FROM student_depression WHERE city IS NOT NULL GROUP BY city HAVING COUNT(*) > 1000 ORDER BY depression_rate_pct DESC;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "robust NL2SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-054", "difficulty": "hard", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "high financial stress با suicidal thoughts لینک داره؟ aggregate امن بده.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "SELECT CASE WHEN financial_stress>=4 THEN 'high_financial' ELSE 'lower_financial' END AS financial_segment,COUNT(*) AS n,ROUND(100.0*SUM(suicidal_thoughts)/COUNT(*),2) AS suicidal_thought_rate_pct FROM student_depression WHERE financial_stress IS NOT NULL AND suicidal_thoughts IS NOT NULL GROUP BY financial_segment ORDER BY suicidal_thought_rate_pct DESC;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "advanced robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-028", "difficulty": "medium", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "تریتمنت تو شرکتای تک چقدره؟", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "SELECT tech_company, COUNT(*) AS n, ROUND(100.0*SUM(treatment)/COUNT(*),2) AS treatment_rate_pct FROM workplace_mental_health_survey WHERE tech_company IS NOT NULL GROUP BY tech_company ORDER BY tech_company DESC;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "robust NL2SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-055", "difficulty": "hard", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "ریسک High رو بر اساس محیط کار بده و میانگین خواب هم اضافه کن.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "SELECT work_environment,COUNT(*) AS n,SUM(CASE WHEN mental_health_risk='High' THEN 1 ELSE 0 END) AS high_risk_count,ROUND(100.0*SUM(CASE WHEN mental_health_risk='High' THEN 1 ELSE 0 END)/COUNT(*),2) AS high_risk_rate_pct,ROUND(AVG(sleep_hours),2) AS avg_sleep FROM mental_health_general GROUP BY work_environment ORDER BY high_risk_rate_pct DESC;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "advanced robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-027", "difficulty": "medium", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "استرس کاری بالا چه بلایی سر پروداکتیویتی آورده؟", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "SELECT CASE WHEN stress_level <= 3 THEN 'low' WHEN stress_level <= 7 THEN 'medium' ELSE 'high' END AS stress_bucket, COUNT(*) AS n, ROUND(AVG(productivity_score),2) AS avg_productivity FROM mental_health_general WHERE stress_level IS NOT NULL GROUP BY stress_bucket ORDER BY MIN(stress_level);", "recommended_visual": "bar_chart", "evaluation_focus_fa": "robust NL2SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-079", "difficulty": "complex", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "policy maturity رو بساز بعد با remote_work کراس کن و گروه‌های بالای ۳۰ نمونه رو نگه دار.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql_with_caveat", "expected_clarification_fa": "", "expected_sql": "WITH s AS (SELECT remote_work,treatment,(CASE WHEN benefits='Yes' THEN 1 ELSE 0 END+CASE WHEN care_options='Yes' THEN 1 ELSE 0 END+CASE WHEN seek_help='Yes' THEN 1 ELSE 0 END) AS score FROM workplace_mental_health_survey WHERE remote_work IS NOT NULL) SELECT remote_work,CASE WHEN score>=2 THEN 'stronger_policy' ELSE 'weaker_policy' END AS policy_segment,COUNT(*) AS n,ROUND(100.0*SUM(treatment)/COUNT(*),2) AS treatment_rate_pct FROM s GROUP BY remote_work,policy_segment HAVING COUNT(*)>30 ORDER BY remote_work DESC,treatment_rate_pct DESC;", "recommended_visual": "heatmap", "evaluation_focus_fa": "complex robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-076", "difficulty": "complex", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "story داشبورد studnt deprassion با sleep cgpa acad pressure بساز.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql_with_caveat", "expected_clarification_fa": "", "expected_sql": "WITH b AS (SELECT CASE WHEN academic_pressure>=4 THEN 'high_pressure' ELSE 'lower_pressure' END AS pressure_segment, CASE WHEN sleep_mid_hours<6 THEN 'low_sleep' ELSE 'other_sleep' END AS sleep_segment, depression_flag,cgpa_10 FROM student_depression WHERE academic_pressure IS NOT NULL AND sleep_mid_hours IS NOT NULL) SELECT pressure_segment,sleep_segment,COUNT(*) AS n,ROUND(100.0*SUM(depression_flag)/COUNT(*),2) AS depression_rate_pct,ROUND(AVG(cgpa_10),2) AS avg_cgpa FROM b GROUP BY pressure_segment,sleep_segment ORDER BY depression_rate_pct DESC;", "recommended_visual": "heatmap", "evaluation_focus_fa": "complex robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-077", "difficulty": "complex", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "policy maturty تو workplace رو با treatmnt rate بسنج.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql_with_caveat", "expected_clarification_fa": "", "expected_sql": "WITH s AS (SELECT treatment,(CASE WHEN benefits='Yes' THEN 1 ELSE 0 END+CASE WHEN care_options='Yes' THEN 1 ELSE 0 END+CASE WHEN wellness_program='Yes' THEN 1 ELSE 0 END+CASE WHEN seek_help='Yes' THEN 1 ELSE 0 END+CASE WHEN anonymity='Yes' THEN 1 ELSE 0 END) AS score FROM workplace_mental_health_survey) SELECT CASE WHEN score<=1 THEN 'low_policy' WHEN score<=3 THEN 'mid_policy' ELSE 'high_policy' END AS policy_maturity,COUNT(*) AS n,ROUND(AVG(score),2) AS avg_score,ROUND(100.0*SUM(treatment)/COUNT(*),2) AS treatment_rate_pct FROM s GROUP BY policy_maturity ORDER BY avg_score;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "complex robust SQL", "dialect": "sqlite"}

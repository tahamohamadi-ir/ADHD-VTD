{"id": "VTD-EVAL-017", "difficulty": "easy", "evaluation_type": "typo_synonym", "user_utterance_fa": "cgpa بچه‌های depressed چنده؟", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "ترکیب انگلیسی/فارسی را بفهمد", "expected_sql": "SELECT ROUND(AVG(cgpa_10), 2) AS avg_cgpa_depressed FROM student_depression WHERE depression_flag = 1 AND cgpa_10 IS NOT NULL;", "recommended_visual": "kpi", "evaluation_focus_fa": "typo_synonym", "dialect": "sqlite"}
{"id": "VTD-EVAL-052", "difficulty": "hard", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "work interfere با تریتمنت تو survey شرکتا چه نسبتی داره؟", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "SELECT work_interfere,COUNT(*) AS n,ROUND(100.0*SUM(treatment)/COUNT(*),2) AS treatment_rate_pct FROM workplace_mental_health_survey WHERE work_interfere IS NOT NULL GROUP BY work_interfere ORDER BY treatment_rate_pct DESC;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "advanced robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-078", "difficulty": "complex", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "global prevalance depression از 1990 تا 2019 برای Iran/Germany/India مقایسه کن.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql_with_caveat", "expected_clarification_fa": "", "expected_sql": "SELECT country_name,year,ROUND(prevalence_pct,4) AS depression_pct FROM country_prevalence_long WHERE disorder='depression' AND country_name IN ('Iran','Germany','India') AND year BETWEEN 1990 AND 2019 ORDER BY country_name,year;", "recommended_visual": "line_chart", "evaluation_focus_fa": "complex robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-053", "difficulty": "hard", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "کشورها رو رتبه افسردگی بده بعد فقط ایران رو جدا کن.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "WITH r AS (SELECT country_name,prevalence_pct,RANK() OVER (ORDER BY prevalence_pct DESC) AS depression_rank FROM country_prevalence_long WHERE disorder='depression' AND year=(SELECT MAX(year) FROM country_prevalence_long)) SELECT country_name,ROUND(prevalence_pct,4) AS depression_pct,depression_rank FROM r WHERE country_name='Iran';", "recommended_visual": "table", "evaluation_focus_fa": "advanced robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-054", "difficulty": "hard", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "high financial stress با suicidal thoughts لینک داره؟ aggregate امن بده.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "SELECT CASE WHEN financial_stress>=4 THEN 'high_financial' ELSE 'lower_financial' END AS financial_segment,COUNT(*) AS n,ROUND(100.0*SUM(suicidal_thoughts)/COUNT(*),2) AS suicidal_thought_rate_pct FROM student_depression WHERE financial_stress IS NOT NULL AND suicidal_thoughts IS NOT NULL GROUP BY financial_segment ORDER BY suicidal_thought_rate_pct DESC;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "advanced robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-055", "difficulty": "hard", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "ریسک High رو بر اساس محیط کار بده و میانگین خواب هم اضافه کن.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql", "expected_clarification_fa": "", "expected_sql": "SELECT work_environment,COUNT(*) AS n,SUM(CASE WHEN mental_health_risk='High' THEN 1 ELSE 0 END) AS high_risk_count,ROUND(100.0*SUM(CASE WHEN mental_health_risk='High' THEN 1 ELSE 0 END)/COUNT(*),2) AS high_risk_rate_pct,ROUND(AVG(sleep_hours),2) AS avg_sleep FROM mental_health_general GROUP BY work_environment ORDER BY high_risk_rate_pct DESC;", "recommended_visual": "bar_chart", "evaluation_focus_fa": "advanced robust SQL", "dialect": "sqlite"}
{"id": "VTD-EVAL-076", "difficulty": "complex", "evaluation_type": "typo_synonym_or_multi_turn", "user_utterance_fa": "story داشبورد studnt deprassion با sleep cgpa acad pressure بساز.", "context_fa": null, "turns": null, "should_generate_sql": true, "expected_action": "generate_sql_with_caveat", "expected_clarification_fa": "", "expected_sql": "WITH b AS (SELECT CASE WHEN academic_pressure>=4 THEN 'high_pressure' ELSE 'lower_pressure' END AS pressure_segment, CASE WHEN sleep_mid_hours<6 THEN 'low_sleep' ELSE 'other_sleep' END AS sleep_segment, depression_flag,cgpa_10 FROM student_depression WHERE academic_pressure IS NOT NULL AND sleep_mid_hours IS NOT NULL) SELECT pressure_segment,sleep_segment,COUNT(*) AS n,ROUND(100.0*SUM(depression_flag)/COUNT(*),2) AS depression_rate_pct,ROUND(AVG(cgpa_10),2) AS avg_cgpa FROM b GROUP BY pressure_segment,sleep_segment ORDER BY depression_rate_pct DESC;", "recommended_visual": "heatmap", "evaluation_focus_fa": "complex robust SQL", "dialect": "sqlite"}
